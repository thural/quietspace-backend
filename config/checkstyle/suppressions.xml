<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC
          "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
          "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Test methods use given_when_then snake_case naming by project convention -->
    <suppress checks="MethodName" files="[/\\]src[/\\]test[/\\]"/>
    <!-- ArchUnit rule fields use lowercase idiomatic naming -->
    <suppress checks="ConstantName" files="ArchitectureRulesTest\.java"/>
</suppressions>
